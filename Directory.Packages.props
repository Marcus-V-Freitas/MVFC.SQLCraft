<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <TestcontainersVersion>4.16.0</TestcontainersVersion>
    <Net10Version>10.0.14</Net10Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(Net10Version)" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.3" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="MVFC.Pack.Analyzers" Version="4.0.2" />
    <PackageVersion Include="sqlkata" Version="4.0.1" />
    <PackageVersion Include="sqlkata.execution" Version="4.0.1" />
    <PackageVersion Include="microsoft.data.sqlclient" Version="7.1.1" />
    <PackageVersion Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageVersion Include="MySqlConnector" Version="3.0.0" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="System.Data.SQLite" Version="2.0.4" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="$(Net10Version)" />
    <PackageVersion Include="SourceGear.sqlite3" Version="3.53.4" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="FluentAssertions" Version="[7.0.0]" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Testcontainers.Oracle" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="Testcontainers.MySql" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="Testcontainers.MsSql" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="Testcontainers.FirebirdSql" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="MinVer" Version="8.1.0-alpha.1" />
  </ItemGroup>
</Project>